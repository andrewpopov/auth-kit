{
  "name": "@andrewpopov/auth-kit",
  "version": "0.5.0",
  "description": "Authentication primitives: password hashing, opaque tokens, refresh-session rotation, and provider-neutral OIDC external-identity binding. OAuth proof, account linking, placeholder claims, and provisioning are run through injected storage/policy ports; user CRUD, RBAC, sessions, and framework adapters stay app-specific. Ships real-adapter conformance suites.",
  "author": "Andrew Popov",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andrewpopov/auth-kit.git" },
  "bugs": { "url": "https://github.com/andrewpopov/auth-kit/issues" },
  "homepage": "https://github.com/andrewpopov/auth-kit#readme",
  "keywords": [
    "authentication",
    "refresh-token",
    "rotation",
    "password-hashing",
    "oauth",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:dist-fresh": "node scripts/verify-dist-fresh.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:pack"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "bcryptjs": "^2.4.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
